// Snake. Steer with the arrow keys or W, A, S and D, eat the food to grow,
// and don't run into the walls or into yourself. The snake speeds up every
// time it eats, and every game has new colors. Until a key is pressed, the
// snake plays itself.

// The board is the whole screen: 20 columns, and as many rows of about
// the same height as fit, stretched a little to fill it exactly. There's no
// rounding, so a loop counts the rows that fit, and the middle row.
var columns = 20
var cellWidth = width / columns
var rows = 1
while (rows + 1) * cellWidth <= height
  rows = rows + 1
end
var cellHeight = height / rows
var middle = 0
while (middle + 1) * 2 <= rows
  middle = middle + 1
end

// The snake is two lists, the column and the row of each of its parts, from
// the tail to the head.
var bodyCols = list
var bodyRows = list

// Which way it's going, a column and a row at a time, and which way the
// last key pressed asks it to go next.
var dx = 1  var dy = 0
var nextDx = 1  var nextDy = 0

var foodCol = 0
var foodRow = 0
var delay = .2
var playing = false

// The snake and its food share a color, and the background is its opposite.
var snakeColor
var background

// The center of a cell, in pixels.
var across = fn(col)
  return col * cellWidth + cellWidth / 2
end
var down = fn(row)
  return row * cellHeight + cellHeight / 2
end

// True when part of the snake is in the cell.
var onSnake = fn(col row)
  for var i = 0 to length of bodyCols
    if bodyCols at i is col and bodyRows at i is row
      return true
    end
  end
  return false
end

// Puts the food in a random cell the snake isn't in.
var placeFood = fn()
  foodCol = random whole 0 to columns
  foodRow = random whole 0 to rows
  while onSnake(foodCol foodRow)
    foodCol = random whole 0 to columns
    foodRow = random whole 0 to rows
  end
end

// True when a cell is on the board and the snake isn't in it.
var free = fn(col row)
  return col >= 0 and col < columns and row >= 0 and row < rows and not onSnake(col row)
end

// Before a game starts, the snake plays itself: it turns toward the food,
// or failing that any safe way, but never straight back.
var autoCol = 0
var autoRow = 0
var chosen = false

var tryWay = fn(wx wy)
  if not chosen and not (wx is 0 - dx and wy is 0 - dy) and free(autoCol + wx autoRow + wy)
    nextDx = wx  nextDy = wy
    chosen = true
  end
end

var autoSteer = fn()
  autoCol = bodyCols at (length of bodyCols - 1)
  autoRow = bodyRows at (length of bodyRows - 1)
  chosen = false
  if foodCol > autoCol tryWay(1 0) end
  if foodCol < autoCol tryWay(-1 0) end
  if foodRow > autoRow tryWay(0 1) end
  if foodRow < autoRow tryWay(0 -1) end
  tryWay(dx dy)
  tryWay(0 1)  tryWay(0 -1)  tryWay(1 0)  tryWay(-1 0)
end

// Picks a random color for the snake and the food, and the opposite color,
// each channel turned around, for the background.
var pickColors = fn()
  var r = random whole 0 to 256
  var g = random whole 0 to 256
  var b = random whole 0 to 256
  snakeColor = "rgb(" + r + "," + g + "," + b + ")"
  background = "rgb(" + (255 - r) + "," + (255 - g) + "," + (255 - b) + ")"
  set color background end
end

// A snake of four parts, heading right, in new colors, playing itself until
// a key is pressed.
var newGame = fn()
  bodyCols = list
  bodyRows = list
  for var i = 0 to 4
    append 6 + i to bodyCols
    append middle to bodyRows
  end
  dx = 1  dy = 0
  nextDx = 1  nextDy = 0
  delay = .2
  playing = false
  pickColors()
  placeFood()
end

// The first key pressed starts a game. Every key then turns the snake
// toward it, but never straight back into itself.
var steer = fn(key)
  if not playing
    newGame()
    playing = true
  end
  if (key is "up arrow" or key is "w") and dy is not 1
    nextDx = 0  nextDy = -1
  end
  if (key is "down arrow" or key is "s") and dy is not -1
    nextDx = 0  nextDy = 1
  end
  if (key is "left arrow" or key is "a") and dx is not 1
    nextDx = -1  nextDy = 0
  end
  if (key is "right arrow" or key is "d") and dx is not -1
    nextDx = 1  nextDy = 0
  end
  playing = true
end

// Draws the snake and the food.
var show = fn()
  clear
  for var i = 0 to length of bodyCols
    add across(bodyCols at i) : down(bodyRows at i)
      size cellWidth : cellHeight color snakeColor outline white 1 shadow black 20
    end
  end
  add across(foodCol) : down(foodRow)
    size cellWidth : cellHeight color snakeColor outline white 1 shadow black 20
  end
  draw
end

// One step: steer, if the snake is playing itself, move the head a cell,
// then eat, grow or end the game.
every delay seconds
  if not playing autoSteer() end
  dx = nextDx  dy = nextDy
  var headCol = bodyCols at (length of bodyCols - 1) + dx
  var headRow = bodyRows at (length of bodyRows - 1) + dy

  if not free(headCol headRow)
    newGame()
  else if headCol is foodCol and headRow is foodRow
    append headCol to bodyCols
    append headRow to bodyRows
    if playing delay = delay * .9 end
    placeFood()
  else
    // Every part moves up to the place of the part ahead of it, and the
    // head moves into the new cell.
    for var i = 0 to length of bodyCols - 1
      bodyCols at i = bodyCols at (i + 1)
      bodyRows at i = bodyRows at (i + 1)
    end
    bodyCols at (length of bodyCols - 1) = headCol
    bodyRows at (length of bodyRows - 1) = headRow
  end
  show()
end

newGame()
show()
onkey steer
